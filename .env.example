# 复制为 .env 并填入真实值；.env 已被 gitignore，绝不提交
MYSQL_HOST=172.25.41.137
MYSQL_PORT=3306
MYSQL_DB=community
MYSQL_USER=community
MYSQL_PASSWORD=YOUR_DB_PASSWORD_HERE
REDIS_HOST=172.25.41.137
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_REDIS_PASSWORD_HERE
JWT_SECRET=YOUR_JWT_SECRET_HERE_AT_LEAST_32_BYTES
OAUTH_AES_KEY=YOUR_AES_KEY_BASE64_32_BYTES_HERE
GITHUB_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
GITEE_CLIENT_ID=YOUR_GITEE_CLIENT_ID
GITEE_CLIENT_SECRET=YOUR_GITEE_CLIENT_SECRET
OAUTH_REDIRECT_BASE_URL=http://localhost:5173
# Agent 联调取消期间：本地建议改为 discard 口，避免 webhook 422/超时噪声刷屏（与 CI 一致）
# AGENT_WEBHOOK_URL=http://127.0.0.1:9/api/v1/events
AGENT_WEBHOOK_URL=http://172.25.41.137:18000/api/v1/events
STEWARD_WEBHOOK_SECRET=YOUR_STUDENT_WEBHOOK_SECRET_32_BYTES_HEX
# M7-2 MinIO（真实 root/access 只写服务器/本机 .env，勿提交）
# 联调读图走 9080（nginx /media/），不要让浏览器直连 9000
MINIO_ENDPOINT=http://172.25.41.137:9000
MINIO_ROOT_USER=YOUR_MINIO_ROOT_USER
MINIO_ROOT_PASSWORD=YOUR_MINIO_ROOT_PASSWORD
MINIO_ACCESS_KEY=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=YOUR_MINIO_SECRET_KEY
MINIO_BUCKET=geekstack
MINIO_PUBLIC_BASE_URL=http://172.25.41.137:9080
MEDIA_RATE_LIMIT_PER_MINUTE=20

# ---- M13 AI（T-AI-0+，真实 Key 只写根目录 .env）----
# Java 网关 POST /api/v1/ai/ask → {AI_SERVICE_URL}/v1/ask/stream
# 开发栈：bash deploy/dev/sync-ai-stack.sh 后本机连服务器端口
AI_SERVICE_URL=http://172.25.41.137:8090
MIMO_API_KEY=YOUR_MIMO_API_KEY_HERE
MIMO_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5
MIMO_THINKING=disabled

# Embedding 与 Java community.rag / ai-service 必须同源（T-AI-0 定稿）
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY_HERE
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# Qdrant：Java 索引写、ai-service 检索读；collection 名两边一致
QDRANT_URL=http://172.25.41.137:6333
# 注意：若本机 shell 曾 export QDRANT_URL=:memory:（ai-service spike），请先取消，否则会盖住上值
QDRANT_COLLECTION=geekstack_community
RAG_PUBLIC_BASE_URL=http://localhost:5173
RAG_SEED_HELP=false
AI_RATE_LIMIT_PER_HOUR=10
RETRIEVE_TOP_K=5
RETRIEVE_SCORE_THRESHOLD=0.35
